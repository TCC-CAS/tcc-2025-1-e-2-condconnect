@startuml UC_Vendedor

left to right direction
skinparam actorStyle awesome
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial

skinparam usecase {
    BackgroundColor #1B4F8A
    FontColor white
    BorderColor #0D3369
    FontSize 13
    Padding 12
}
skinparam actor {
    BackgroundColor #1B4F8A
    FontColor white
    BorderColor #0D3369
    FontSize 14
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #EEF4FF
    BorderColor #1B4F8A
    FontColor #1B4F8A
    FontSize 12
    FontStyle bold
    RoundCorner 10
}
skinparam ArrowColor #555555
skinparam ArrowFontSize 10

title Casos de Uso — Vendedor (papel do Morador)

actor "Vendedor" as V

rectangle "CondConnect — Sistema" {

    rectangle "Gestão de Anúncios" {
        (UC06 Cadastrar produto/serviço) as UC06
        (UC07 Editar produto) as UC07
        (UC08 Remover produto) as UC08
    }

    rectangle "Negociação" {
        (UC13 Responder proposta) as UC13
    }

    rectangle "Pedidos" {
        (UC16 Confirmar entrega) as UC16
    }

    rectangle "Analytics e Relatórios" {
        (UC20 Visualizar dashboard de vendas) as UC20
        (UC21 Visualizar relatório completo) as UC21
        (UC22 Exportar relatório em Excel) as UC22
    }
}

V --> UC06
V --> UC07
V --> UC08
V --> UC13
V --> UC16
V --> UC20
V --> UC21
V --> UC22

UC22 ..> UC21 : <<include>>

@enduml
