@startuml UC_Administrador

left to right direction
skinparam actorStyle awesome
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial

skinparam usecase {
    BackgroundColor #1B4F8A
    FontColor white
    BorderColor #0D3369
    FontSize 13
    Padding 12
}
skinparam actor {
    BackgroundColor #1B4F8A
    FontColor white
    BorderColor #0D3369
    FontSize 14
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #EEF4FF
    BorderColor #1B4F8A
    FontColor #1B4F8A
    FontSize 12
    FontStyle bold
    RoundCorner 10
}
skinparam ArrowColor #555555
skinparam ArrowFontSize 10

title Casos de Uso — Administrador

actor "Administrador" as A

rectangle "CondConnect — Sistema" {

    rectangle "Moderação de Produtos" {
        (UC23 Gerenciar produtos) as UC23
    }

    rectangle "Gerenciamento de Usuários" {
        (UC24 Gerenciar usuários) as UC24
        (UC25 Suspender ou banir usuário) as UC25
    }

    rectangle "Denúncias" {
        (UC26 Resolver denúncias) as UC26
        (UC29 Moderar denúncias de usuários e chat) as UC29
    }

    rectangle "Painel e Estatísticas" {
        (UC27 Visualizar estatísticas globais) as UC27
    }
}

A --> UC23
A --> UC24
A --> UC25
A --> UC26
A --> UC27
A --> UC29

UC25 ..> UC24 : <<extend>>
UC29 ..> UC26 : <<extend>>

@enduml
