@startuml DiagramaCasosDeUso_CondConnect

left to right direction
skinparam actorStyle awesome
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam usecase {
    BackgroundColor #1B4F8A
    FontColor white
    BorderColor #0D3369
    FontSize 13
    Padding 12
}
skinparam actor {
    BackgroundColor #1B4F8A
    FontColor white
    BorderColor #0D3369
    FontSize 13
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #EEF4FF
    BorderColor #1B4F8A
    FontColor #1B4F8A
    FontSize 12
    FontStyle bold
    RoundCorner 10
}
skinparam ArrowColor #555555
skinparam ArrowFontSize 10

title Diagrama de Casos de Uso — CondConnect

' ── Atores ───────────────────────────────────────────────────────────────────
actor "Morador" as M
actor "Vendedor\n(papel do Morador)" as V
actor "Comprador\n(papel do Morador)" as C
actor "Administrador" as A

' ── Sistema ──────────────────────────────────────────────────────────────────
rectangle "  CondConnect — Sistema  " {

    rectangle "Autenticação e Conta" as gr1 {
        (UC01 Cadastrar usuário) as UC01
        (UC02 Realizar login com 2FA) as UC02
        (UC03 Recuperar senha) as UC03
        (UC04 Editar perfil) as UC04
        (UC05 Gerenciar configurações) as UC05
    }

    rectangle "Marketplace" as gr2 {
        (UC06 Cadastrar produto/serviço) as UC06
        (UC07 Editar produto) as UC07
        (UC08 Remover produto) as UC08
        (UC09 Buscar produto) as UC09
        (UC10 Favoritar produto) as UC10
    }

    rectangle "Negociação e Compra" as gr3 {
        (UC11 Adicionar ao carrinho) as UC11
        (UC12 Fazer proposta de preço) as UC12
        (UC13 Responder proposta) as UC13
        (UC14 Finalizar compra) as UC14
    }

    rectangle "Pedidos e Pós-Venda" as gr4 {
        (UC15 Acompanhar pedidos) as UC15
        (UC16 Confirmar entrega) as UC16
        (UC17 Enviar mensagem) as UC17
        (UC18 Avaliar vendedor) as UC18
        (UC19 Denunciar produto ou usuário) as UC19
    }

    rectangle "Analytics e Relatórios" as gr5 {
        (UC20 Visualizar dashboard de vendas) as UC20
        (UC21 Visualizar relatório completo) as UC21
        (UC22 Exportar relatório em Excel) as UC22
    }

    rectangle "Acessibilidade" as gr6 {
        (UC28 Utilizar recursos de acessibilidade) as UC28
    }

    rectangle "Administração" as gr7 {
        (UC23 Gerenciar produtos) as UC23
        (UC24 Gerenciar usuários) as UC24
        (UC25 Suspender ou banir usuário) as UC25
        (UC26 Resolver denúncias) as UC26
        (UC27 Visualizar estatísticas globais) as UC27
        (UC29 Moderar denúncias de usuários e chat) as UC29
    }
}

' ── Morador ──────────────────────────────────────────────────────────────────
M --> UC01
M --> UC02
M --> UC03
M --> UC04
M --> UC05
M --> UC09
M --> UC10
M --> UC15
M --> UC17
M --> UC19
M --> UC28

' ── Vendedor ─────────────────────────────────────────────────────────────────
V --> UC06
V --> UC07
V --> UC08
V --> UC13
V --> UC16
V --> UC20
V --> UC21
V --> UC22

' ── Comprador ────────────────────────────────────────────────────────────────
C --> UC11
C --> UC12
C --> UC14
C --> UC18

' ── Administrador ────────────────────────────────────────────────────────────
A --> UC23
A --> UC24
A --> UC25
A --> UC26
A --> UC27
A --> UC29

' ── Relacionamentos entre casos de uso ───────────────────────────────────────
UC14 ..> UC11 : <<include>>
UC22 ..> UC21 : <<include>>
UC16 ..> UC15 : <<include>>
UC18 ..> UC14 : <<include>>
UC25 ..> UC24 : <<extend>>
UC29 ..> UC26 : <<extend>>
UC03 ..> UC02 : <<extend>>

@enduml
